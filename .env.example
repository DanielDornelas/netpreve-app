# Endereço da API (sem barra no final). Copie este arquivo para .env e ajuste.
# Emulador Android com a API rodando no seu computador:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Celular físico na mesma rede Wi-Fi (troque pelo IP do seu computador):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
# API publicada no Render:
# EXPO_PUBLIC_API_BASE_URL=https://seu-servico.onrender.com
